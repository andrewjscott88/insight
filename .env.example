# Copy to .env and replace BOTH values. Never commit .env.
INSIGHT_PASSWORD=replace-with-a-long-unique-password
INSIGHT_SESSION_SECRET=replace-with-at-least-32-random-secret-characters
# Optional local Python settings:
# INSIGHT_DATA_DIR=data
# INSIGHT_DATABASE_URL=sqlite:///data/insight.db
# INSIGHT_ALLOWED_HOSTS=localhost,127.0.0.1
# INSIGHT_SECURE_COOKIES=0
# Behind a reverse proxy (docs/RUNBOOK.md, "Reverse proxy"): the proxy's address(es) as seen by Insight,
# IPs or CIDR networks. Forwarded headers from anyone else are ignored. Never "*".
# INSIGHT_TRUSTED_PROXIES=172.18.0.1
# Most restrictive TLP label this instance stores (default AMBER+STRICT: TLP:RED is refused).
# INSIGHT_MAX_TLP=AMBER+STRICT
# Require an authenticator-app code at sign-in (default off). `make mfa-enable` pairs the app and sets this.
# INSIGHT_MFA=off
# Temporary password-free development access. Anyone who reaches this workspace can view and change its
# data while on. Keep the password and session secret above; set off and restart to require sign-in again.
# Requires INSIGHT_MFA=off. Browser sessions, CSRF checks and API-key rules remain in place.
# INSIGHT_DEV_NO_AUTH=off
# Default colour theme for browsers that have not picked one (default system: follow the device's light/dark
# setting). Each browser can still choose Light, Dark or System in the workspace header. `make theme THEME=dark`.
# INSIGHT_THEME=system
# Run scheduled syncs in this process (default on). Schedules are off until you choose one in the Sources tab
# or with `insight schedule`. Set off in every process but one if you ever run several.
# INSIGHT_RUN_JOBS=on
# Automatic CVE lookups (switched on in the Sources tab) are faster with a free NIST NVD API key: one request
# every 0.7 s instead of every 6.5 s. Request one at https://nvd.nist.gov/developers/request-an-api-key.
# INSIGHT_NVD_API_KEY=
#
# Alerts (docs/ALERTS.md). Destinations are added in the Watch terms tab; these settings say how to send.
# The address people open Insight at, for links in alerts.
# INSIGHT_PUBLIC_URL=https://insight.example.org
# E-mail alerts need a mail server. Security: starttls (default, port 587), tls (port 465) or none (only for a
# relay on this host, such as localhost:25).
# INSIGHT_SMTP_HOST=mail.example.org
# INSIGHT_SMTP_PORT=587
# INSIGHT_SMTP_SECURITY=starttls
# INSIGHT_SMTP_USERNAME=insight@example.org
# INSIGHT_SMTP_PASSWORD=
# INSIGHT_SMTP_FROM=insight@example.org
# Webhooks may only reach public internet addresses. Set on to allow a chat or automation server on your own
# network (cloud metadata addresses stay blocked).
# INSIGHT_ALERT_PRIVATE_TARGETS=off
