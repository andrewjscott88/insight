# Copy to .env and replace BOTH values. Never commit .env.
INSIGHT_PASSWORD=replace-with-a-long-unique-password
INSIGHT_SESSION_SECRET=replace-with-at-least-32-random-secret-characters
# Optional local Python settings:
# INSIGHT_DATA_DIR=data
# INSIGHT_DATABASE_URL=sqlite:///data/insight.db
# INSIGHT_ALLOWED_HOSTS=localhost,127.0.0.1
# INSIGHT_SECURE_COOKIES=0
# Behind a reverse proxy (docs/RUNBOOK.md, "Reverse proxy"): the proxy's address(es) as seen by Insight,
# IPs or CIDR networks. Forwarded headers from anyone else are ignored. Never "*".
# INSIGHT_TRUSTED_PROXIES=172.18.0.1
# Most restrictive TLP label this instance stores (default AMBER+STRICT: TLP:RED is refused).
# INSIGHT_MAX_TLP=AMBER+STRICT
# Require an authenticator-app code at sign-in (default off). `make mfa-enable` pairs the app and sets this.
# INSIGHT_MFA=off
# Default colour theme for browsers that have not picked one (default system: follow the device's light/dark
# setting). Each browser can still choose Light, Dark or System in the workspace header. `make theme THEME=dark`.
# INSIGHT_THEME=system
# Run scheduled syncs in this process (default on). Schedules are off until you choose one in the Sources tab
# or with `insight schedule`. Set off in every process but one if you ever run several.
# INSIGHT_RUN_JOBS=on
