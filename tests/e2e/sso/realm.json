{
  "realm": "insight",
  "displayName": "Insight gate (test realm)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": false,
  "groups": [
    {"name": "insight-viewers"},
    {"name": "insight-analysts"},
    {"name": "insight-admins"}
  ],
  "clients": [
    {
      "clientId": "insight",
      "name": "Insight",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "@CLIENT_SECRET@",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": ["https://insight.insight.test/login/sso/callback"],
      "webOrigins": ["https://insight.insight.test"],
      "attributes": {"pkce.code.challenge.method": "S256"},
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false",
            "claim.name": "groups"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "viewer",
      "enabled": true,
      "email": "viewer@insight.test",
      "emailVerified": true,
      "firstName": "Vera",
      "lastName": "Viewer",
      "credentials": [{"type": "password", "value": "@PASSWORD@", "temporary": false}],
      "groups": ["/insight-viewers"]
    },
    {
      "username": "analyst",
      "enabled": true,
      "email": "analyst@insight.test",
      "emailVerified": true,
      "firstName": "Andy",
      "lastName": "Analyst",
      "credentials": [{"type": "password", "value": "@PASSWORD@", "temporary": false}],
      "groups": ["/insight-analysts"]
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@insight.test",
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Admin",
      "credentials": [{"type": "password", "value": "@PASSWORD@", "temporary": false}],
      "groups": ["/insight-admins"]
    },
    {
      "username": "newcomer",
      "enabled": true,
      "email": "newcomer@insight.test",
      "emailVerified": true,
      "firstName": "Noor",
      "lastName": "Newcomer",
      "credentials": [{"type": "password", "value": "@PASSWORD@", "temporary": false}],
      "groups": []
    }
  ]
}
