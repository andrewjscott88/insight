        [
          "email",
          "Reply.Team+Case42@xn--caf-dma.example"
        ]
      ]
    },
    {
      "id": "email-malformed",
      "text": "Rejected .leading@example.org, trailing.@example.net and two..dots@example.com.",
      "expected": []
    },
    {
      "id": "email-in-url",
      "text": "Archived directory: https://portal.example.org/profiles/owner@example.net",
      "expected": [
        [
          "url",
          "https://portal.example.org/profiles/owner@example.net"
        ],
        [
          "domain",
          "portal.example.org"
        ]
      ]
    },
    {
      "id": "file-names",
      "text": "The archive invoice.pdf contained setup.exe and readme.txt.",
      "expected": [],
      "note": "Trap: file names look like domains."
    },
    {
      "id": "version-string",
      "text": "Fixed in firmware version 10.2.3.4 and agent 7.1.0.2.",
      "expected": [],
      "note": "Trap: four-part version numbers look like IPv4."
    },
    {
      "id": "code-snippet",
      "text": "The script called os.path.join and subprocess.run with shell=True.",
      "expected": [],
      "note": "Trap: dotted code identifiers look like domains."
    },
    {
      "id": "timestamps",
      "text": "Activity between 10:15:30 and 11:00:00 UTC on 2025-01-01.",
      "expected": [],
      "note": "Trap: clock times contain colons like IPv6."
    },
    {
      "id": "invalid-ip",
      "text": "A malformed entry read 999.10.10.10 in the log.",
      "expected": []
    },
    {
      "id": "credential-url",
      "text": "A paste contained https://admin:hunter2@portal.example.com/ which we did not visit.",
      "expected": [
        [
          "url",
          "https://portal.example.com/"
        ],
        [
          "domain",
          "portal.example.com"
        ]
      ],
      "note": "Credentials are stripped: the URL and its host are kept, the secret is never stored."
    },
    {
      "id": "no-indicators",
      "text": "This advisory discusses patching cadence and contains no technical indicators.",
      "expected": []
    },
    {
